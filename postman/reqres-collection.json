        {
          "name": "Buscar dados",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has users\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.data.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"First user has email\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.data[0].email).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Email is a string\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.data[0].email).to.be.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time less than 1000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"user_id\", jsonData.data[0].id);\r",
                  "\r",
                  "console.log(\"User ID salvo:\", jsonData.data[0].id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
