                  "    pm.expect(jsonData.name).to.eql(\"Claudia Updated\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Job updated correctly\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.job).to.eql(\"Senior QA Tester\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains updatedAt\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.updatedAt).to.exist;\r",
                  "});"
                ],
