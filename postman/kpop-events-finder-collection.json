        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains id\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.user).to.exist;\r",
                  "    pm.expect(jsonData.user.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Name is correct\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.user.name).to.eql(\"Claudia\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Email is correct\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    const bodyEmail = JSON.parse(pm.request.body.raw).email;\r",
                  "    pm.expect(jsonData.user.email).to.eql(bodyEmail);\r",
                  "});\r",
                  "\r",
                  "// Salva o token para os próximos requests\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.environment.set(\"token\", jsonData.token);\r",
                  "console.log(\"Token salvo:\", jsonData.token);"
